# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
APP_URL=http://127.0.0.1:3001/

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Must match Back-End/.env
AI_ROUTER_TOKEN=
# Google AI Studio (Gemini) is the default provider
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_STUDIO_MODEL=gemini-2.5-flash
# Optional fallback providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
AI_DEFAULT_PROVIDER=auto
AI_PROVIDER_PRIORITY=google,groq,mistral,ollama
AI_ENABLE_FALLBACK=true
AI_REQUEST_TIMEOUT=60
AI_MAX_REQUEST_BYTES=131072
AI_MAX_HISTORY_TURNS=10
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_SECONDS=60
AI_SYSTEM_PROMPT=